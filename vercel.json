{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 300
    },
    "api/conversation-webhook.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron-expire-memories",
      "schedule": "0 7 * * *"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
