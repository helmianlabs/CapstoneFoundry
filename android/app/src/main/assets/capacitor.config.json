{
	"appId": "com.capstonefoundry.app",
	"appName": "Capstone Foundry",
	"server": {
		"url": "https://www.capstonefoundry.cloud/app",
		"cleartext": false,
		"androidScheme": "https",
		"allowNavigation": [
			"www.capstonefoundry.cloud",
			"capstonefoundry.cloud",
			"*.capstonefoundry.cloud",
			"capstonefoundry.vercel.app",
			"*.vercel.app"
		]
	},
	"webDir": "dist",
	"android": {},
	"plugins": {
		"LocalNotifications": {
			"smallIcon": "ic_stat_icon_config_sample",
			"iconColor": "#488AFF",
			"sound": "beep.wav"
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
